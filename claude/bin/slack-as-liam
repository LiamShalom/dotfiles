#!/usr/bin/env bash
# Call a Slack API method as Liam, with his user token from Keychain.
# Posts made this way show as Liam with no "Sent using Claude" tag, which the Slack MCP adds.
#   slack-as-liam chat.postMessage channel=C0123 text="Hello"
#   slack-as-liam chat.postMessage channel=C0123 thread_ts=1712345678.123456 text="Reply"
#   slack-as-liam upload <channel-id> <file> [comment] [thread_ts]   share a file in a channel or DM
# Setup: ~/dotfiles/claude/slack/README.md
set -euo pipefail

# Only the methods needed to send as Liam; anything else (admin calls) is refused.
case "${1:-}" in
  chat.postMessage|chat.scheduleMessage|chat.update|chat.delete|reactions.add|reactions.remove|conversations.open|conversations.create|conversations.invite|conversations.kick|users.lookupByEmail|auth.test|files.delete|upload) ;;
  *) echo "slack-as-liam: method '${1:-}' is not allowed" >&2; exit 2 ;;
esac

# Creating a channel and adding or removing its members changes who sees what. CHANNEL_OK=1 only when
# Liam asked for that channel change in this chat.
case "$1" in
  conversations.create|conversations.invite|conversations.kick)
    if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ "${CHANNEL_OK:-}" != 1 ]; then
      echo "slack-as-liam: $1 changes channel membership. Set CHANNEL_OK=1 only when Liam asked for this channel change." >&2
      exit 2
    fi ;;
esac

# An agent post must not promise vendor contact that Liam has not asked for (coldtrace 11-17,
# petaluma health 11-17: "no need to contact whop"). VENDOR_CONTACT_OK=1 when he asked for it.
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ "${VENDOR_CONTACT_OK:-}" != 1 ] && { [ "$1" = chat.postMessage ] || [ "$1" = chat.update ]; }; then
  text=$(printf '%s\n' "$@" | sed -n 's/^text=//p')
  if printf '%s' "$text" | grep -Eiq "(check(ing)?|ask(ing)?|reach(ing)? out|ping(ing)?|follow(ing)? up|loop(ing)? in|escalat(e|ing)|contact(ing)?|email(ing)?)( back)? (with |to |in )?(whop|stripe|meta|facebook|tiktok|apify|crawlzo|revenuecat|vercel|google|apple|shopify)\b"; then
    echo "slack-as-liam: this text promises contact with a vendor. Liam did not ask for that; drop the promise (set VENDOR_CONTACT_OK=1 only when he asked for the contact)." >&2
    exit 2
  fi
fi

# An agent post states only the data of the SideShift accounts its channel belongs to (j2 melaxin 11-20:
# a run read two other "Dr. Melaxin" accounts by name and posted their campaigns and creators in J2's
# channel). ACCOUNTS=<companyId,...> names the accounts the text's facts come from; ACCOUNTS=none when
# it states no account data. A channel's scope lives in ~/.claude/state/slack-eyes-accounts.json (shared
# with slack-eyes.mjs). A post may save one account as a new channel's scope; "internal" or several
# accounts are set with `slack-eyes.mjs --accounts`, which refuses "internal" for a shared channel.
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  channel="" scoped=""
  case "$1" in
    chat.postMessage|chat.update|chat.scheduleMessage)
      scoped=1
      for arg in "$@"; do
        case "$arg" in
          channel=*)
            if [ -n "$channel" ]; then echo "slack-as-liam: give channel= once." >&2; exit 2; fi
            channel="${arg#channel=}" ;;
        esac
      done ;;
    upload) scoped=1; channel="${2:-}" ;;
  esac
  if [ -n "$scoped" ]; then
    # The check reads text= (or an upload's comment) only, so text must not ride in other fields.
    if [ "$1" != upload ]; then
      ntext=0
      for arg in "$@"; do
        case "$arg" in
          text=*) ntext=$((ntext + 1)) ;;
          blocks=*|attachments=*|markdown_text=*) echo "slack-as-liam: post plain text= only; blocks, attachments and markdown_text are not checked." >&2; exit 2 ;;
        esac
      done
      if [ "$1" != chat.update ] || [ "$ntext" -gt 0 ]; then
        if [ "$ntext" -ne 1 ]; then echo "slack-as-liam: give text= exactly once." >&2; exit 2; fi
      fi
    fi
    if ! [[ "$channel" =~ ^[CGD][A-Z0-9]{6,}$ ]]; then
      echo "slack-as-liam: give the channel by its ID (C…, G… or D…), not '$channel'." >&2
      exit 2
    fi
    if [ "${channel#D}" = "$channel" ]; then
      scope_file="$HOME/.claude/state/slack-eyes-accounts.json"
      if [ -e "$scope_file" ] && ! jq -e 'type == "object"' "$scope_file" >/dev/null 2>&1; then
        echo "slack-as-liam: $scope_file cannot be read, so this post cannot be checked. Tell Liam." >&2
        exit 2
      fi
      saved=$(jq -r --arg c "$channel" '.[$c].accounts // [] | join(",")' "$scope_file" 2>/dev/null || true)
      if [ -z "${ACCOUNTS:-}" ]; then
        echo "slack-as-liam: name the SideShift company accounts whose data this text states: ACCOUNTS=<companyId,...> (ACCOUNTS=none if it states none).${saved:+ This channel belongs to: $saved.} Find a channel's account by team membership, never by brand name: same-named accounts are other customers." >&2
        exit 2
      fi
      # "internal" holds only while the channel is not shared with another company; unknown counts as shared.
      if [ "$saved" = internal ] && [ "$ACCOUNTS" != none ]; then
        itoken=$(security find-generic-password -s claude-slack-user-token -w 2>/dev/null || true)
        info=$( (cd "$HOME" && SLACK_USER_TOKEN="$itoken" env -u SLACK_BOT_TOKEN slack api --skip-update conversations.info channel="$channel") 2>/dev/null | sed -n '/^{/,$p' || true)
        if [ "$(jq -r 'if .ok == true and (.channel.is_ext_shared | not) and (.channel.is_pending_ext_shared | not) then "internal" else "shared" end' <<<"$info" 2>/dev/null)" != internal ]; then
          echo "slack-as-liam: $channel is saved as internal, but it is shared with another company (or Slack did not say). Name only its own account's data, and tell Liam the scope is wrong." >&2
          exit 2
        fi
      fi
      if [ "$ACCOUNTS" != none ] && [ "$saved" != internal ]; then
        if [ -z "$saved" ]; then
          one="${ACCOUNTS// /}"
          if [ -z "$one" ] || [ "$one" = internal ] || [ "${one#*,}" != "$one" ] || ! [[ "$one" =~ ^[A-Za-z0-9_-]{8,}$ ]]; then
            echo "slack-as-liam: this channel has no saved account scope. A post saves one company id (proven by team membership) as its scope; \"internal\" or several accounts are Liam's to set." >&2
            exit 2
          fi
          foreign=$(node "$HOME/.claude/bin/account-foreign-terms.mjs" "$one" 2>/dev/null || true)
          if ! jq -e 'type == "object" and (.others | type == "array") and (.terms | type == "array")' >/dev/null 2>&1 <<<"$foreign"; then
            echo "slack-as-liam: could not look up the accounts that share $one's name, so this post cannot be checked. Try again; if it keeps failing, tell Liam." >&2
            exit 2
          fi
          mkdir -p "$(dirname "$scope_file")"
          [ -s "$scope_file" ] || echo '{}' > "$scope_file"
          tmp=$(mktemp)
          jq --arg c "$channel" --arg a "$one" --arg t "$(date -u +%FT%TZ)" --argjson f "$foreign" '.[$c] = {accounts: [$a], setAt: $t, foreign: $f}' "$scope_file" > "$tmp" && mv "$tmp" "$scope_file"
          saved="$one"
        else
          outside=""
          IFS=',' read -ra wanted <<<"$ACCOUNTS"
          for id in "${wanted[@]}"; do
            id="${id// /}"
            [ -z "$id" ] && continue
            case ",$saved," in *",$id,"*) ;; *) outside="$outside $id" ;; esac
          done
          if [ -n "$outside" ]; then
            echo "slack-as-liam: this text states data from account(s)$outside, but this channel belongs to $saved. Same-named accounts are other customers: drop their campaigns, settings and creators. If the saved scope looks wrong, tell Liam." >&2
            exit 2
          fi
        fi
      fi
      # The text itself, whatever ACCOUNTS says: another same-named account's campaign names, company
      # ids, or "the other <brand> account" (foreign terms saved with the scope by account-foreign-terms.mjs).
      if [ -n "$saved" ] && [ "$saved" != internal ] && ! jq -e --arg c "$channel" '.[$c].foreign | type == "object"' "$scope_file" >/dev/null 2>&1; then
        echo "slack-as-liam: $channel's scope has no lookup of same-named accounts, so this post cannot be checked. Tell Liam." >&2
        exit 2
      fi
      if [ "$saved" != internal ]; then
        if [ "$1" = upload ]; then body="${4:-}"; else body=""; for arg in "$@"; do case "$arg" in text=*) body="${arg#text=}" ;; esac; done; fi
        norm=" $(printf '%s' "$body" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/ /g; s/^ +| +$//g') "
        hits=""
        while IFS= read -r term; do
          [ -n "$term" ] && case "$norm" in *" $term "*) hits="$hits; \"$term\"" ;; esac
        done < <(jq -r --arg c "$channel" '.[$c].foreign.terms // [] | .[]' "$scope_file" 2>/dev/null)
        while IFS= read -r id; do
          [ -n "$id" ] && case "$body" in *"$id"*) hits="$hits; account id $id" ;; esac
        done < <(jq -r --arg c "$channel" '.[$c].foreign.others // [] | .[]' "$scope_file" 2>/dev/null)
        brand=$(jq -r --arg c "$channel" '.[$c].foreign.name // empty' "$scope_file" 2>/dev/null | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/ /g; s/^ +| +$//g')
        if [ -n "$brand" ] && printf '%s' "$norm" | grep -Eq "(^| )(other|another|second|third|both)( [a-z0-9]+){0,6} $brand( |$)"; then hits="$hits; another \"$brand\" account"; fi
        if [ -n "$hits" ]; then
          echo "slack-as-liam: this text names another account with the same brand name (${hits#; }). This channel belongs to ${saved:-its own account}; drop the other account's campaigns, settings and creators." >&2
          exit 2
        fi
      fi
    fi
  fi
fi

# An agent's thread reply stays short and tags a person once per thread (olive 11-18: six replies of
# 300-450 characters, each tagging the reporter). LONG_OK=1 / RETAG_OK=1 when Liam asked for it.
tag_mark=""
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ "$1" = chat.postMessage ]; then
  text="" thread="" channel=""
  for arg in "$@"; do
    case "$arg" in
      text=*) text="${arg#text=}" ;;
      thread_ts=*) thread="${arg#thread_ts=}" ;;
      channel=*) channel="${arg#channel=}" ;;
    esac
  done
  body=$(printf '%s' "$text" | sed -E '1s/^[[:space:]]*<@[A-Z0-9]+(\|[^>]*)?>[[:space:]]*//')
  if [ "${LONG_OK:-}" != 1 ] && [ "${#body}" -gt 280 ]; then
    echo "slack-as-liam: this reply is ${#body} characters; Liam's stay under 280, most one line. Cut it to the answer and the one number or fact the reader needs (LONG_OK=1 only when he asked for a long one)." >&2
    exit 2
  fi
  tag=$(printf '%s' "$text" | sed -nE '1s/^[[:space:]]*<@([A-Z0-9]+).*/\1/p')
  if [ -n "$thread" ] && [ -n "$tag" ]; then
    tag_mark="$HOME/.cache/slack-as-liam/tagged/${channel}_${thread}_${tag}"
    if [ -e "$tag_mark" ] && [ "${RETAG_OK:-}" != 1 ]; then
      echo "slack-as-liam: you already tagged <@$tag> in this thread. Drop the tag: they are in the conversation (RETAG_OK=1 only after a long gap)." >&2
      exit 2
    fi
  fi
fi

if ! token=$(security find-generic-password -s claude-slack-user-token -w 2>/dev/null); then
  echo "slack-as-liam: no token in Keychain (service claude-slack-user-token). See ~/dotfiles/claude/slack/README.md" >&2
  exit 1
fi

cd "$HOME"
api() { SLACK_USER_TOKEN="$token" env -u SLACK_BOT_TOKEN slack api --skip-update "$@"; }

# A Slack :eyes: job's session that posts in another thread (an escalation to a vendor's channel)
# keeps following it: the watcher reads that thread too and sends the replies to this session.
follow() {
  [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ -x "$HOME/.claude/bin/slack-eyes.mjs" ] || return 0
  "$HOME/.claude/bin/slack-eyes.mjs" --posted "$@" >/dev/null || true
}

if [ "$1" = upload ]; then
  channel="${2:?usage: slack-as-liam upload <channel-id> <file> [comment] [thread_ts]}"
  file="${3:?usage: slack-as-liam upload <channel-id> <file> [comment] [thread_ts]}"
  comment="${4:-}"
  thread="${5:-}"
  name=$(basename "$file")
  size=$(stat -f %z "$file")
  r=$(api files.getUploadURLExternal filename="$name" length="$size")
  [ "$(jq -r .ok <<<"$r")" = true ] || { echo "slack-as-liam: $(jq -r .error <<<"$r")" >&2; exit 1; }
  url=$(jq -r .upload_url <<<"$r")
  id=$(jq -r .file_id <<<"$r")
  code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$url" --data-binary @"$file")
  [ "$code" = 200 ] || { echo "slack-as-liam: upload POST returned $code" >&2; exit 1; }
  args=(files.completeUploadExternal "files=[{\"id\":\"$id\",\"title\":$(jq -Rn --arg t "$name" '$t')}]" channel_id="$channel")
  [ -n "$comment" ] && args+=(initial_comment="$comment")
  [ -n "$thread" ] && args+=(thread_ts="$thread")
  rc=0
  done=$(api "${args[@]}") || rc=$?
  printf '%s\n' "$done"
  [ "$rc" = 0 ] || exit "$rc"
  if [ -n "$thread" ] && [ "$(jq -r '.ok // false' <<<"$done" 2>/dev/null)" = true ]; then follow "$channel" "$thread" "$thread"; fi
  exit 0
fi

if [ "$1" != chat.postMessage ]; then
  SLACK_USER_TOKEN="$token" exec env -u SLACK_BOT_TOKEN slack api --skip-update "$@"
fi
rc=0
out=$(api "$@") || rc=$?
printf '%s\n' "$out"
[ "$rc" = 0 ] || exit "$rc"
if [ "$(jq -r '.ok // false' <<<"$out" 2>/dev/null)" = true ]; then
  if [ -n "$tag_mark" ]; then mkdir -p "$(dirname "$tag_mark")"; : > "$tag_mark"; fi
  follow "$(jq -r '.channel // empty' <<<"$out")" "$(jq -r '.ts // empty' <<<"$out")" "$(jq -r '.message.thread_ts // empty' <<<"$out")"
fi
