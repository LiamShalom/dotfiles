#!/usr/bin/env python3
"""Refuse a merge while any reported GitHub check has not passed or skipped."""
import json
import subprocess
import sys

if len(sys.argv) != 2:
    sys.exit("usage: pr-checks-green <pr-number> | --from-stdin")
if sys.argv[1] == "--from-stdin":
    checks = json.load(sys.stdin)
else:
    result = subprocess.run(
        ["gh", "pr", "checks", sys.argv[1], "--json", "name,state,link"],
        capture_output=True, text=True,
    )
    if not result.stdout.strip():
        sys.exit(result.stderr.strip() or "No check results returned")
    checks = json.loads(result.stdout)
if not checks:
    sys.exit("Blocked: no check results returned")
blocked = [c for c in checks if c.get("state") not in {"SUCCESS", "SKIPPED"}]
for check in blocked:
    print(f"Blocked: {check.get('name', 'unnamed')} [{check.get('state', 'missing state')}]")
if blocked:
    sys.exit(1)
print(f"All {len(checks)} checks passed or skipped")
