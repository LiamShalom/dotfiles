#!/bin/bash
#
# heavy — run a command in one of N machine-wide slots, so only N heavy jobs
# (full test suites, builds, whole-repo typecheck or lint) run at once across
# every agent session. A job waits until a slot is free. The PreToolUse hook
# (hooks/heavy-gate.sh) wraps heavy agent commands in this automatically.
#
# Slots are kernel file locks (macOS /usr/bin/lockf), released when the job
# exits, even if it crashes. If the slots cannot be used at all (a sandbox
# that blocks /tmp), the command runs unqueued rather than not at all.
#
# --pool keeps a separate set of slots: iOS builds and tests (`--pool xcode`)
# queue among themselves, so a long UI test run never holds up a Vitest suite.
#
# A job from a session pinned in Session Board goes first: jobs from other
# sessions wait while it waits, and it may also use spare slots that only
# pinned jobs use (HEAVY_PINNED_SLOTS, 1 by default, none for the build pool).
#
# Usage:  heavy [--pool NAME] <command> [args...]
#         HEAVY_SLOTS=2 by default; the xcode pool uses HEAVY_XCODE_SLOTS=2
set -uo pipefail

POOL="slot"
SLOTS="${HEAVY_SLOTS:-2}"
WHAT="test suites or builds"
# A job starts only while at least this much memory is free (percent). Slots
# alone count jobs, not gigabytes: on 2026-11-04 a `next build` (~45 GB)
# beside three full typechecks (6-12 GB each) filled all 128 GB.
MIN_FREE="${HEAVY_MIN_FREE_PCT:-10}"
PIN_SLOTS="${HEAVY_PINNED_SLOTS:-1}"

# Percent of RAM that is not wired, app memory or the compressor's own pages.
# kern.memorystatus_level is not used: it counts compressed memory as free, and
# on 2026-11-11 read 48 while 227 MB was unused and swap was 91% full.
mem_free_pct() {
	vm_stat 2>/dev/null | awk -v total="$(sysctl -n hw.memsize 2>/dev/null)" '
		/page size of/ { for (i = 1; i < NF; i++) if ($i == "of") ps = $(i + 1) }
		/^Pages wired down/ { w = $NF }
		/^Anonymous pages/ { a = $NF }
		/^Pages occupied by compressor/ { c = $NF }
		END {
			if (!ps || !total || !a) exit 1
			f = 100 - (w + a + c) * ps * 100 / total
			printf "%d", (f < 0 ? 0 : f)
		}'
}
if [ "${1:-}" = "--mem-free" ]; then
	mem_free_pct && echo
	exit
fi
if [ "${1:-}" = "--pool" ]; then
	POOL="$2"
	shift 2
	if [ "$POOL" = "xcode" ]; then
		SLOTS="${HEAVY_XCODE_SLOTS:-2}"
		WHAT="iOS builds or tests"
	elif [ "$POOL" = "build" ]; then
		# A Next production build peaks at 40-60 GB here: one at a time, and
		# only with room for it. The classifier also takes a normal slot after.
		SLOTS="${HEAVY_BUILD_SLOTS:-1}"
		WHAT="a next build"
		MIN_FREE="${HEAVY_BUILD_MIN_FREE_PCT:-35}"
		# A second 40-60 GB build would fill the memory, pinned or not.
		PIN_SLOTS=0
	fi
fi

# HEAVY_PINNED=1 or 0 overrides the check (for tests).
if [ -n "${HEAVY_PINNED:-}" ]; then
	PINNED="$HEAVY_PINNED"
elif node "$HOME/.claude/bin/pinned-sessions.mjs" --pid $$ 2>/dev/null; then
	PINNED=1
else
	PINNED=0
fi

# Refuse when the disk is nearly full: unlike memory, it does not free itself
# when other jobs end.
case "$POOL" in
	build) DISK_LEVEL=build ;;
	xcode) DISK_LEVEL=heavy ;;
	*) DISK_LEVEL=light ;;
esac
if [ -x "$HOME/.claude/bin/disk-guard" ]; then
	"$HOME/.claude/bin/disk-guard" "$DISK_LEVEL" || exit 1
fi

DIR="/tmp/agent-heavy-$(id -u)"
# Present while this job waits for memory or a slot, gone once it starts:
# Session Board keeps a chat whose task only waits here in Working, not in
# Needs you once it has waited an hour.
queued="$DIR/queued.$$"
mkdir -p "$DIR" 2>/dev/null && : > "$queued" 2>/dev/null
# pinwait.<pool>.<pid>: a pinned job waits for a slot in <pool>, so other jobs
# in that pool let it go first.
pinwait="$DIR/pinwait.$POOL.$$"
trap 'rm -f "$queued" "$pinwait"' EXIT

# Wait for free memory, at most MEM_WAIT seconds; after that run anyway, so a
# machine that stays full never blocks every agent for good.
MEM_WAIT="${HEAVY_MEM_WAIT_SECS:-900}"
waited=0
while :; do
	free=$(mem_free_pct) || break
	[ -n "$free" ] && [ "$free" -lt "$MIN_FREE" ] || break
	if [ "$waited" -ge "$MEM_WAIT" ]; then
		echo "heavy: memory still ${free}% free after ${MEM_WAIT}s; running anyway" >&2
		break
	fi
	[ "$waited" -eq 0 ] && echo "heavy: only ${free}% of memory is free (need ${MIN_FREE}% for $WHAT); waiting..." >&2
	sleep 10
	waited=$((waited + 10))
done
started="$DIR/started.$$"

unqueued() {
	echo "heavy: cannot use the job slots in $DIR; running without the queue" >&2
	rm -f "$queued"
	exec "$@"
}
mkdir -p "$DIR" 2>/dev/null && [ -w "$DIR" ] || unqueued "$@"

# A job may hold a slot for at most MAX_SECS, then it is stopped with everything
# it started. On 11-17 hung iOS runs held both iOS slots for 4 and 6 hours, and
# their sessions sat in Working with nothing to act on.
case "$POOL" in
	xcode) MAX_SECS="${HEAVY_XCODE_MAX_SECS:-3600}" ;;
	*) MAX_SECS="${HEAVY_MAX_SECS:-2700}" ;;
esac
# Runs inside the slot: the job in its own process group (set -m), a watchdog
# that stops that group at the limit, and a trap that passes a cancel on to it.
# shellcheck disable=SC2016
RUN_JOB=': > "$1"; rm -f "$2" "$4"; max=$3; shift 4
set -m
"$@" &
job=$!
# The watchdog writes its notice to the job stderr (fd 3) but keeps no other
# handle on it, so it never holds the caller output open.
( sleep "$max"
  if kill -0 "$job" 2>/dev/null; then
    echo "heavy: stopped after $((max / 60)) min holding a slot; the job ran too long or hung" >&3
    kill -TERM -- "-$job" 2>/dev/null; sleep 10; kill -KILL -- "-$job" 2>/dev/null
  fi ) </dev/null >/dev/null 3>&2 2>/dev/null &
dog=$!
set +m
trap "kill -TERM -- -$job 2>/dev/null" TERM INT HUP
wait "$job"; rc=$?
# wait returns early when a trapped signal arrives: wait again for the real exit.
while kill -0 "$job" 2>/dev/null; do wait "$job"; rc=$?; done
kill -- "-$dog" 2>/dev/null
exit "$rc"'

# True while a job from a pinned session waits for a slot in this pool. A file
# left by a killed waiter is removed.
pinned_waiting() {
	local f
	for f in "$DIR/pinwait.$POOL".*; do
		[ -e "$f" ] || continue
		kill -0 "${f##*.}" 2>/dev/null && return 0
		rm -f "$f"
	done
	return 1
}

slot_files=()
for i in $(seq 1 "$SLOTS"); do slot_files+=("$DIR/$POOL.$i"); done
if [ "$PINNED" = 1 ]; then
	: > "$pinwait" 2>/dev/null
	# The spare slots come last, so they stay free for the next pinned job.
	# (Not seq: macOS `seq 1 0` counts down and would make a slot.)
	for ((i = 1; i <= PIN_SLOTS; i++)); do slot_files+=("$DIR/${POOL}pin.$i"); done
fi

notified=0
while :; do
	if [ "$PINNED" != 1 ] && pinned_waiting; then
		slots_now=()
	else
		slots_now=("${slot_files[@]}")
	fi
	for slot in ${slots_now[@]+"${slots_now[@]}"}; do
		rm -f "$started"
		# lockf exits 75 when the slot is busy; the marker file tells that apart
		# from the job itself exiting 75.
		lockf -s -t 0 "$slot" /bin/sh -c "$RUN_JOB" sh "$started" "$queued" "$MAX_SECS" "$pinwait" "$@"
		rc=$?
		if [ -e "$started" ]; then
			rm -f "$started"
			exit "$rc"
		fi
		# The job never started: busy (75) means try the next slot; anything
		# else means the slots are unusable.
		[ "$rc" -eq 75 ] || unqueued "$@"
	done
	if [ "$notified" -eq 0 ]; then
		if [ "${#slots_now[@]}" -eq 0 ]; then
			echo "heavy: jobs from pinned sessions go first; waiting for a slot..." >&2
		else
			echo "heavy: all ${#slots_now[@]} slots are busy (other agents are running $WHAT); waiting for one..." >&2
		fi
		notified=1
	fi
	sleep 5
done
