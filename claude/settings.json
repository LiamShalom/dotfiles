{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1",
    "ANTHROPIC_BASE_URL": "https://proxy.sideshift.cloud",
    "ANTHROPIC_AUTH_TOKEN": "REDACTED-set-on-each-machine",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5-20251001",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1[1m]",
    "API_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "inherit",
    "CLAUDE_CODE_ENABLE_TASKS": "0",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/ready-banner:~/.claude/mods/session-chrome"
  },
  "permissions": {
    "allow": [],
    "defaultMode": "bypassPermissions"
  },
  "disabledMcpjsonServers": [
    "chrome-devtools",
    "sideshift-firestore",
    "cloud-sql-postgres-read-replica"
  ],
  "model": "cc/claude-opus-5-5[1m]",
  "skillOverrides": {
    "codebase-design": "off",
    "domain-modeling": "off",
    "git-guardrails-claude-code": "off",
    "mcp-builder": "off",
    "systematic-debugging": "off",
    "test-driven-development": "off",
    "to-tickets": "off",
    "wayfinder": "off",
    "graphify": "off",
    "shalomify": "off",
    "handoff": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-env-local.sh",
            "timeout": 10,
            "statusMessage": "Linking worktree .env.local"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/correction-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-printed-tokens.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/prod-change-none-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/heavy-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/iphone-only-sim.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-tiktok-oembed-liveness.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__slack__slack_(send_message|send_message_draft|schedule_message|get_file_upload_url|complete_file_upload|add_reaction|create_canvas|update_canvas|create_list|update_list|add_list_record|update_list_record|create_conversation)",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/slack-send-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch|mcp__notion__notion-fetch|mcp__chrome-devtools__navigate_page|mcp__chrome-devtools__new_page",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notion-site-read.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-claude-artifacts.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/ask-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/finish-judge.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/finish-judge.sh",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "if [ -x \"$HOME/.claude/recompact/bin/recompact\" ]; then \"$HOME/.claude/recompact/bin/recompact\" statusline -- \"$HOME/.claude/statusline.sh\" || \"$HOME/.claude/statusline.sh\"; else \"$HOME/.claude/statusline.sh\"; fi",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "ecc@ecc": false,
    "vercel@claude-plugins-official": false,
    "comprehensive-review@tag1consulting": false,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "segment-recompact@segment-recompact": true
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    },
    "tag1consulting": {
      "source": {
        "source": "github",
        "repo": "tag1consulting/claude-plugins"
      }
    },
    "segment-recompact": {
      "source": {
        "source": "github",
        "repo": "Don-Osipov/segment_recompact"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "tui": "fullscreen",
  "preferredNotifChannel": "terminal_bell",
  "agentPushNotifEnabled": true,
  "hasCompletedOnboarding": true
}
