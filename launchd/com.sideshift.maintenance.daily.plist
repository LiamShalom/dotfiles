<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh replaces __HOME__ and loads it. See claude/bin/maintenance.sh.
     If the Mac is asleep at 04:00, launchd runs it on wake. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sideshift.maintenance.daily</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.claude/bin/maintenance.sh</string>
		<string>daily</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude/logs/maintenance.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude/logs/maintenance.launchd.log</string>
</dict>
</plist>
