<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh replaces __HOME__ and loads it. See claude/bin/learning-weekly.sh.
     Monday 08:00, so the report is fresh when the week starts; if the Mac is asleep then,
     launchd runs it on wake. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sideshift.learning.weekly</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.claude/bin/learning-weekly.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude/logs/learning/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude/logs/learning/launchd.log</string>
</dict>
</plist>
