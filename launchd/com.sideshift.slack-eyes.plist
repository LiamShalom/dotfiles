<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh replaces __HOME__ and loads it. See claude/bin/slack-eyes.mjs.
     Pause: touch ~/.claude/state/slack-eyes.PAUSED -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sideshift.slack-eyes</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/env</string>
		<string>node</string>
		<string>__HOME__/.claude/bin/slack-eyes.mjs</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/opt/node@24/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>__HOME__</string>
	</dict>
	<key>StartInterval</key>
	<integer>30</integer>
	<!-- Each :eyes: job runs in a detached process for up to 4 hours; launchd must not kill it when the check exits. -->
	<key>AbandonProcessGroup</key>
	<true/>
	<!-- Standard, not Background: its background claude call can start the Claude daemon, and the
	     daemon and every background session under it inherit this class. Under Background they
	     all ran throttled and taskpolicy -B (board-priority.mjs) could not lift them (11-18).
	     board-priority.mjs moves the sessions' work to the background itself. -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude/logs/slack-eyes.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude/logs/slack-eyes.launchd.log</string>
</dict>
</plist>
